---
import Base from "../layouts/Base.astro";
import AtomCount from "../components/AtomCount.astro";
import Html from "../components/Html.astro";
import { content, projectInfo } from "../lib/content";
const S = content("site").labels("site");
const home = content("home");
const T = home.labels("page");
const facts = home.pairs("facts");

// Every MDX file in src/pages/projects/ with status "published" is listed (all of them in dev).
const modules = import.meta.glob("./projects/*.mdx", { eager: true }) as Record<string, any>;
const thumbs = import.meta.glob("../components/viz/*/Thumb.astro", { eager: true }) as Record<string, any>;
const FIELDS = ["blue", "red", "green", "ochre"];
const projects = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path.split("/").pop()!.replace(".mdx", "");
    return { ...mod.frontmatter, ...projectInfo(slug), slug, href: `/projects/${slug}/`, Thumb: thumbs[`../components/viz/${slug}/Thumb.astro`]?.default };
  })
  .filter((p) => p.status === "published" || import.meta.env.DEV)
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const month = (d: unknown) => new Date(d as string).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---
<Base world="iso" contact={false} title={T.title} description={T.description}>
  <section class="wrap hero">
    <div class="hero-text">
      <h1>{T.headline}</h1>
      <p class="lead"><Html html={home.inline("lead")} /></p>
      <div class="actions">
        <a class="btn" href={`mailto:${S.email}`}>{T.cta}</a>
        <a class="more" href="#work">{T.see_projects}</a>
      </div>
    </div>
    <AtomCount />
  </section>

  <section id="work" class="wrap work" aria-labelledby="work-h">
    <h2 id="work-h">{T.projects_heading}</h2>
    <ul class="gallery">
      {projects.map((p, i) => (
        <li class:list={["tile", `f-${FIELDS[i % FIELDS.length]}`, { newest: i === 0, wide: i > 0 && i === projects.length - 1 && i % 2 === 1 }]}>
          <a href={p.href}>
            {p.Thumb && <div class="fig"><p.Thumb title={p.title} /></div>}
            <div class="band">
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <span class="meta">{month(p.date)} · {p.tags?.[0]}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" class="wrap about" aria-labelledby="about-h">
    <h2 id="about-h">{T.about_heading}</h2>
    <p class="about-lead"><Html html={home.inline("about")} /></p>
    <dl class="facts">
      {facts.map((f, i) => (
        <div><dt set:html={f.label} /><dd><Html html={f.value} />{i === facts.length - 1 && <span class="langs" aria-hidden="true">{FIELDS.slice(0, 3).map((c) => <svg class={`f-${c}`} viewBox="0 0 20 18"><path d="M3 1h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-5 4v-4H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2z" /></svg>)}</span>}</dd></div>
      ))}
    </dl>
  </section>

  <section id="contact" class="close" aria-label="Contact">
    <div class="wrap close-in">
      <a class="close-cta" href={`mailto:${S.email}`}>{T.close_cta}</a>
      <a class="close-alt" href={S.linkedin_url} target="_blank" rel="noopener">{T.close_alt}</a>
    </div>
  </section>
</Base>

<style>
  h2 { font: 800 32px/1.1 var(--f-display); letter-spacing: -.01em; margin: 0 0 20px; }

  /* Hero: the claim and the action, then the live picture statistic (first on mobile after the line). */
  .hero { padding-block: 28px 40px; display: grid; gap: 28px; align-items: center; }
  .hero-text { display: grid; gap: 18px; justify-items: start; min-width: 0; }
  .hero h1 { margin: 0; font: 800 clamp(44px, 9vw, 80px)/1.02 var(--f-display); letter-spacing: -.025em; text-wrap: balance; }
  .lead { margin: 0; max-width: 46ch; font-size: 19px; line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border-radius: 999px; background: var(--ink); color: var(--bg); font: 700 18px/1 var(--f-display); text-decoration: none; transition: background .2s ease-out; }
  .btn:hover { background: var(--ink-2); color: var(--bg); }
  .more { font-weight: 600; font-size: 18px; text-decoration-color: var(--cat-1); text-decoration-thickness: 2px; text-underline-offset: 4px; min-height: 44px; display: inline-flex; align-items: center; }

  /* Gallery: every project once, each on its own colour field; the newest gets double width. */
  .work { padding-block: 32px 24px; }
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  .tile { --field: var(--field-blue); --on: var(--on-field); border-radius: var(--radius); overflow: hidden; background: var(--field); min-width: 0; }
  .f-red { --field: var(--field-red); }
  .f-green { --field: var(--field-green); }
  .f-ochre { --field: var(--field-ochre); --on: var(--on-ochre); }
  .tile a { display: flex; flex-direction: column; height: 100%; color: var(--on); text-decoration: none; }
  .fig { background: var(--panel); margin: 10px 10px 0; border-radius: 4px; padding: 18px; display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 10; min-width: 0; }
  .fig :global(svg) { width: 100%; height: 100%; display: block; }
  .band { padding: 18px 20px 22px; display: grid; gap: 8px; align-content: start; }
  .meta { margin-top: 4px; font-size: 15px; font-weight: 600; opacity: .9; font-variant-numeric: tabular-nums; }
  .band h3 { margin: 0; font: 800 26px/1.1 var(--f-display); letter-spacing: -.01em; text-wrap: balance; }
  .band p { margin: 0; font-size: 16px; line-height: 1.45; text-wrap: pretty; }
  .tile a:hover h3, .tile a:focus-visible h3 { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .tile a { border-radius: var(--radius); }
  .tile a:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .tile:has(a:focus-visible) { overflow: visible; }

  /* About: credentials in plain words and the one action again. */
  .about { padding-block: 40px 0; display: grid; gap: 20px; justify-items: start; }
  .about-lead { margin: 0; max-width: 60ch; font-size: 19px; line-height: 1.5; color: var(--ink-2); }
  .facts { margin: 0; display: grid; gap: 12px; width: 100%; }
  .facts div { display: grid; gap: 2px; }
  .facts dt { font-size: 15px; color: var(--ink-3); }
  .facts dd { margin: 0; font-weight: 700; font-size: 18px; }
  .langs { display: flex; gap: 6px; margin-top: 10px; }
  .langs svg { width: 22px; height: 20px; }
  .langs .f-blue { fill: var(--field-blue); }
  .langs .f-red { fill: var(--field-red); }
  .langs .f-green { fill: var(--field-green); }
  .langs .f-ochre { fill: var(--field-ochre); }

  /* Closing band: the page ends on one red field with the one action. */
  .close { margin-top: 56px; margin-bottom: -64px; background: var(--field-red); color: var(--on-field); }
  .close-in { padding-block: 40px 44px; display: grid; justify-items: start; }
  .close-cta { color: inherit; font: 800 clamp(40px, 8vw, 72px)/1.05 var(--f-display); letter-spacing: -.02em; text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 8px; }
  .close-cta:hover { text-decoration-thickness: 7px; }
  .close-alt { color: inherit; font: 600 18px/1.3 var(--f-display); text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; }
  .close-alt:focus-visible { outline: 2px solid var(--on-field); outline-offset: 3px; border-radius: 2px; }
  .close-cta:focus-visible { outline: 3px solid var(--on-field); outline-offset: 6px; border-radius: 4px; }

  @media (max-width: 559px) {
    .hero { gap: 16px; padding-block-start: 16px; }
    .hero-text { gap: 14px; }
    .lead { font-size: 17px; }
  }

  @media (min-width: 700px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .tile.newest, .tile.wide { grid-column: 1 / -1; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; padding-block: 48px 56px; }
    .tile.newest a, .tile.wide a { flex-direction: row; }
    .tile.wide .fig { flex: 1.4; margin: 10px 0 10px 10px; aspect-ratio: auto; min-height: 260px; }
    .tile.wide .band { flex: 1; align-content: center; padding: 28px 32px; }
    .tile.newest .fig { flex: 1.4; margin: 10px 0 10px 10px; aspect-ratio: auto; min-height: 320px; }
    .tile.newest .band { flex: 1; align-content: center; padding: 28px 32px; }
    .tile.newest h3 { font-size: 36px; }
  }
</style>
