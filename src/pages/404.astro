---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="wrap nf">
    <span class="eyebrow">Error 404</span>
    <h1>This sheet is not in the drawing set.</h1>
    <p>The page you asked for does not exist or has moved.</p>
    <a class="back" href="/">Back to the index</a>
  </section>
</Base>

<style>
  .nf { min-height: 50vh; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .nf p { margin: 0 0 20px; color: var(--ink-2); max-width: var(--measure); }
  .back { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; background: var(--ink); color: var(--bg); font-weight: 600; text-decoration: none; }
</style>
