---
// Schematic 8-lane pool seen from above, not to scale: the wall with the starting blocks, with the T marks painted on the floor 2 m from it and the lane ropes red over the last 5 m.
// 1 m = 14 viewBox units (lane 2.5 m wide = 35). Purely decorative; colours come from the site tokens.
const W = 320, H = 500;
const LANES = 8, LANE_W = 35, X0 = 20, X1 = X0 + LANES * LANE_W;   // 20 .. 300
const WALL = 450, M = 14;                                         // wall y, units per metre
const T_Y = WALL - 2 * M;                                         // T mark: 2 m from the wall
const ROPE_RED = WALL - 5 * M;                                    // ropes turn red over the last 5 m
const cx = (i: number) => X0 + LANE_W * (i + 0.5);

const lines = Array.from({ length: LANES }, (_, i) => i);
const ropes = Array.from({ length: LANES + 1 }, (_, k) => X0 + k * LANE_W + (k === 0 ? 2.5 : k === LANES ? -2.5 : 0));
---
<figure class="pt" role="img" aria-label="Schematic top view of a swimming pool: eight lanes, lane ropes, the T marks painted on the pool floor and the starting blocks on the deck.">
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="pt-fade-g" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#000" /><stop offset=".16" stop-color="#fff" />
      </linearGradient>
      <mask id="pt-fade" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <rect width={W} height={H} fill="url(#pt-fade-g)" />
      </mask>
    </defs>
    <g mask="url(#pt-fade)">
      <rect class="deck" x="0" y={WALL + 9} width={W} height={H - WALL - 9} />
      <rect class="water" x={X0} y="0" width={X1 - X0} height={WALL} />
      {lines.map((i) => i % 2 === 1 && <rect class="water alt" x={X0 + i * LANE_W} y="0" width={LANE_W} height={WALL} />)}

      {lines.map((i) => (
        <g class="lane-mark">
          <path d={`M${cx(i)},0V${T_Y}`} />
          <path class="t-bar" d={`M${cx(i) - 11},${T_Y}h22`} />
          <path class="wall-t" d={`M${cx(i) - 11},${WALL - 3}h22`} />
        </g>
      ))}

      {ropes.map((x) => (
        <g>
          <path class="rope blue" d={`M${x},0V${ROPE_RED}`} />
          <path class="rope red" d={`M${x},${ROPE_RED}V${WALL}`} />
        </g>
      ))}

      <path class="pool-edge" d={`M${X0},0V${WALL}M${X1},0V${WALL}`} />
      <rect class="gutter" x={X0} y={WALL} width={X1 - X0} height="9" />
      <path class="gutter-dash" d={`M${X0 + 4},${WALL + 4.5}H${X1 - 4}`} />
      <path class="deck-edge" d={`M0,${WALL + 9}H${W}`} />
      {lines.map((i) => (
        <g class="block">
          <rect class="base" x={cx(i) - 11} y={WALL + 15} width="22" height="26" rx="2" />
          <path class="tex" d={`M${cx(i) - 7},${WALL + 24}l6,-6M${cx(i) - 7},${WALL + 31}l12,-12M${cx(i) - 2},${WALL + 36}l9,-9M${cx(i) + 3},${WALL + 37}l4,-4`} />
          <path class="lip" d={`M${cx(i) - 11},${WALL + 15}h22`} />
        </g>
      ))}
    </g>
  </svg>
</figure>

<style>
  .pt { margin: 0; display: none; justify-items: center; }
  .pt svg { width: 100%; max-width: 440px; height: auto; display: block; }
  .pt .deck { fill: var(--panel); }
  .pt .water { fill: var(--cat-1); fill-opacity: .62; }
  .pt .water.alt { fill-opacity: .5; }
  .pt .lane-mark path { fill: none; stroke: var(--ink); stroke-width: 3.4; }
  .pt .lane-mark .t-bar { stroke-width: 5; }
  .pt .lane-mark .wall-t { stroke-width: 4; }
  .pt .rope { fill: none; stroke-width: 5; stroke-dasharray: 6.5 2.2; }
  .pt .rope.blue { stroke: var(--panel); }
  .pt .rope.red { stroke: var(--cat-2); }
  .pt .pool-edge { fill: none; stroke: var(--ink); stroke-width: 2; }
  .pt .gutter { fill: var(--bg); stroke: var(--ink); stroke-width: 2; }
  .pt .gutter-dash { fill: none; stroke: var(--ink-3); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .pt .deck-edge { fill: none; stroke: var(--ink); stroke-width: 2; }
  .pt .block .base { fill: var(--panel); stroke: var(--ink); stroke-width: 1.6; }
  .pt .block .tex { fill: none; stroke: var(--ink-3); stroke-width: 1; stroke-linecap: round; }
  .pt .block .lip { stroke: var(--ink); stroke-width: 4; stroke-linecap: butt; }
</style>

<style is:global>
  /* Text on the left, pool on the right from 900px. Below that the illustration is dropped so the chart stays near the top. */
  .sp-intro { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
  @media (min-width: 900px) {
    .sp-intro { grid-template-columns: minmax(0, 1fr) minmax(300px, 440px); gap: 40px; }
    .sp-intro .pt { display: grid; }
  }
</style>
