  .sp-notes { margin: 8px 0 0; padding-top: 6px; border-top: 1px solid var(--rule); font-size: 13px; color: var(--ink-2); }

  .sp-legend { list-style: none; margin: 12px 0 0; padding: 10px 0 0; border-top: 1px solid var(--rule); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; font-size: 13px; line-height: 1.3; color: var(--ink-2); }
  .sp-legend li { display: flex; gap: 8px; align-items: flex-start; }
  .sp-legend li[hidden] { display: none; }
  .sp-legend svg { flex: none; width: 16px; height: 16px; margin-top: 1px; }
  .lg-fill { fill: var(--ink-2); }
  .lg-ring { fill: none; stroke: var(--ink-2); stroke-width: 1.2; }
  .lg-hollow { fill: var(--panel); stroke: var(--ink-2); stroke-width: 1.8; }
  .lg-x { stroke: var(--ink-2); stroke-width: 1.8; fill: none; stroke-linecap: round; }
  .lg-band { fill: var(--ink-3); fill-opacity: .25; }
  .lg-dash { stroke: var(--ink-3); stroke-width: 1.4; stroke-dasharray: 3 3; fill: none; }
