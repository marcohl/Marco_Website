  .sp-ring { fill: none; stroke: var(--c); stroke-width: 1.2; }
  .sp-selring { fill: none; stroke: var(--ink); stroke-width: 1.5; pointer-events: none; }
  .sp-svg .sp-endlabel { font-family: var(--f-data); font-size: 13px; font-weight: 600; fill: var(--ink); }
