  .sp-insights li::before { content: counter(sp); position: absolute; left: 0; top: 1px; width: 24px; height: 24px; border: 1.3px solid var(--ink); border-radius: 50%; background: var(--panel); color: var(--ink); font: 600 12px/22px var(--f-data); text-align: center; }
