  .sp-nav { display: inline-flex; gap: 6px; }
  .sp-nav button { font: 600 18px/1 var(--f-data); color: var(--ink); background: var(--panel); border: 1px solid var(--rule); border-radius: 0; width: 44px; height: 44px; cursor: pointer; }
  .sp-blks { display: grid; gap: 12px; }
  .sp-blk h4 { margin: 0 0 3px; font: 600 12px/1.2 var(--f-data); color: var(--ink-3); display: flex; align-items: center; gap: 6px; }
  .sp-blk .sw { width: 10px; height: 3px; border-radius: 1px; background: var(--c); flex: none; }
  .sp-blk.s-men { --c: var(--cat-1); }
  .sp-blk.s-women { --c: var(--cat-2); }
  .sp-blk ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
