  .sp-nojs { font-size: 14px; color: var(--ink-2); }
  .sp:not(.js) .sp-controls, .sp:not(.js) .sp-stage, .sp:not(.js) .sp-legend { display: none; }

  .sp-insights { min-width: 0; }
