---
// Dumbbell chart of DNV's 10 regions, 2025 (hollow) to 2060 (filled), with a toggle between
// nuclear share of electricity (%) and installed capacity (GW). Rows keep one order (2025 share)
// in both modes, so a row that falls in one mode and rises in the other is easy to see.
// Red rows: capacity grows and share falls. Data: nuclear.json. Text: [[region-chart]], [[regions]].
import d from "../../../data/nuclear-capacity-vs-share/nuclear.json";
import { content } from "../../../lib/content";

const txt = content("projects/nuclear-capacity-vs-share");
const L = txt.labels("region-chart"), NAMES = txt.labels("regions");
const first = d.years[0], last = d.years.at(-1)!;
const text = Object.fromEntries(Object.entries(L).map(([k, s]) => [k, s.replace(/\{first\}/g, String(first)).replace(/\{last\}/g, String(last))]));
const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
const f1 = (n: number) => n.toFixed(1);
const rows = [...d.regions].sort((a, b) => b.share_pct[0] - a.share_pct[0]);
---
<div class="nr" data-viz="nuclear-capacity-vs-share-regions" data-text={JSON.stringify({ ...text, names: NAMES })}>
  <div class="nr-fig">
    <div class="nr-top">
      <div class="nr-seg" role="group" aria-label={L.mode_label}>
        <button type="button" data-mode="share" aria-pressed="true">{L.mode_share}</button>
        <button type="button" data-mode="capacity" aria-pressed="false">{L.mode_capacity}</button>
      </div>
      <ul class="nr-key">
        <li><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" class="k-hollow" /></svg>{text.key_first}</li>
        <li><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" class="k-fill" /></svg>{text.key_last}</li>
        <li><span class="k-bar story"></span>{L.key_story}</li>
        <li><span class="k-bar ctx"></span>{L.key_context}</li>
      </ul>
    </div>
    <svg class="nr-svg" tabindex="0" role="img" aria-label={text.description_share}></svg>
    <div class="nr-card" aria-live="polite"></div>
  </div>
  <details>
    <summary>{text.table_summary}</summary>
    <div class="tbl"><table>
      <caption>{L.table_caption}</caption>
      <thead><tr><th>{L.col_region}</th><th class="num">{text.col_cap0}</th><th class="num">{text.col_cap1}</th><th class="num">{text.col_s0}</th><th class="num">{text.col_s1}</th></tr></thead>
      <tbody>{rows.map((r) => (
        <tr><td>{NAMES[r.code]}</td><td class="num">{f1(r.capacity_gw[0])}</td><td class="num">{f1(r.capacity_gw.at(-1)!)}</td><td class="num">{f1(r.share_pct[0])}%</td><td class="num">{f1(r.share_pct.at(-1)!)}%</td></tr>
      ))}</tbody>
    </table></div>
  </details>
</div>

<script>
  import * as d3 from "d3";
  import data from "../../../data/nuclear-capacity-vs-share/nuclear.json";
  import { fill } from "../../../lib/fill";

  type Mode = "share" | "capacity";
  const f1 = (n: number) => n.toFixed(1);
  const fmt = (n: number) => Math.round(n).toLocaleString("en-US");

  document.querySelectorAll<HTMLElement>('[data-viz="nuclear-capacity-vs-share-regions"]').forEach((root) => {
    root.classList.add("js");
    const L = JSON.parse(root.dataset.text!) as Record<string, string> & { names: Record<string, string> };
    const svgEl = root.querySelector<SVGSVGElement>("svg.nr-svg")!, card = root.querySelector<HTMLElement>(".nr-card")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const rows = [...data.regions].sort((a, b) => b.share_pct[0] - a.share_pct[0]).map((r) => ({
      code: r.code, name: L.names[r.code],
      cap0: r.capacity_gw[0], cap1: r.capacity_gw.at(-1)!, s0: r.share_pct[0], s1: r.share_pct.at(-1)!,
    })).map((r) => ({ ...r, story: r.cap1 > r.cap0 && r.s1 < r.s0 }));
    type Row = (typeof rows)[number];
    let mode: Mode = "share", sel = 0, W = 0;
    const svg = d3.select(svgEl);
    let update: (animate: boolean) => void = () => {};

    const val = (r: Row, end: 0 | 1) => mode === "share" ? (end ? r.s1 : r.s0) : (end ? r.cap1 : r.cap0);
    const lab = (v: number) => mode === "share" ? f1(v) + "%" : fmt(v);

    function draw() {
      const width = Math.round(svgEl.getBoundingClientRect().width) || 320;
      if (width === W) return;
      W = width;
      const narrow = W < 560;
      const RH = narrow ? 46 : 40, TOP = narrow ? 26 : 44, m = { l: narrow ? 150 : 190, r: narrow ? 14 : 110 };
      const H = TOP + rows.length * RH + 6;
      svg.attr("viewBox", `0 0 ${W} ${H}`).attr("height", H).selectAll("*").remove();
      const x = d3.scaleLinear().range([m.l, W - m.r]);
      const yy = (i: number) => TOP + i * RH + RH / 2;

      const gGrid = svg.append("g").attr("class", "grid");
      const gAx = svg.append("g").attr("class", "xax");
      const axT = svg.append("text").attr("class", "axt").attr("x", W - m.r).attr("y", 12).attr("text-anchor", "end");

      const g = svg.append("g").selectAll("g").data(rows).join("g")
        .attr("class", (r) => "row " + (r.story ? "story" : "ctx"))
        .attr("transform", (_, i) => `translate(0 ${yy(i)})`);
      g.append("rect").attr("class", "hit").attr("x", 0).attr("width", W).attr("y", -RH / 2).attr("height", RH);
      g.append("text").attr("class", "nm").attr("x", m.l - 12).attr("dy", narrow ? "-0.25em" : "0.32em").text((r) => r.name);
      const bar = g.append("line").attr("class", "bar");
      const c0 = g.append("circle").attr("class", "c0").attr("r", 5);
      const c1 = g.append("circle").attr("class", "c1").attr("r", 5.5);
      const vt = g.append("text").attr("class", "vt").attr("dy", narrow ? "1.05em" : "0.32em").attr("text-anchor", narrow ? "end" : "start");
      g.on("pointerenter pointerdown", (_, r) => { sel = rows.indexOf(r); mark(); show(); });

      const mark = () => g.classed("on", (_, i) => i === sel);

      update = (animate: boolean) => {
        const max = mode === "share" ? 25 : 450;
        x.domain([0, max]);
        const ticks = mode === "share" ? [0, 10, 20] : [0, 200, 400];
        gGrid.selectAll("line").data(ticks).join("line").attr("x1", (t) => x(t)).attr("x2", (t) => x(t)).attr("y1", TOP - 4).attr("y2", H - 4);
        gAx.selectAll("text").data(ticks).join("text").attr("x", (t) => x(t)).attr("y", TOP - 12).text((t) => t + (mode === "share" ? "%" : ""));
        axT.text(mode === "share" ? L.axis_share : L.axis_capacity).attr("opacity", narrow ? 0 : 1);
        const t = d3.transition().duration(animate && !reduce ? 600 : 0).ease(d3.easeCubicInOut);
        bar.transition(t as any).attr("x1", (r) => x(val(r, 0))).attr("x2", (r) => x(val(r, 1)));
        c0.transition(t as any).attr("cx", (r) => x(val(r, 0)));
        c1.transition(t as any).attr("cx", (r) => x(val(r, 1)));
        vt.text((r) => `${lab(val(r, 0))} → ${lab(val(r, 1))}`).attr("x", narrow ? m.l - 12 : W - m.r + 8);
        svgEl.setAttribute("aria-label", mode === "share" ? L.description_share : L.description_capacity);
      };
      update(false);
      mark();
      svgEl.onkeydown = (ev) => {
        if (ev.key !== "ArrowDown" && ev.key !== "ArrowUp") return;
        ev.preventDefault();
        sel = (sel + (ev.key === "ArrowDown" ? 1 : -1) + rows.length) % rows.length;
        mark(); show();
      };
    }

    function show() {
      const r = rows[sel];
      const vars = { cap0: fmt(r.cap0), cap1: fmt(r.cap1), s0: f1(r.s0), s1: f1(r.s1), pct: r.cap0 > 0 ? Math.round((r.cap1 / r.cap0 - 1) * 100) : "–" };
      card.innerHTML = `<strong>${r.name}</strong>
        <dl><dt>${L.mode_capacity}</dt><dd>${fmt(r.cap0)} → ${fmt(r.cap1)} GW</dd>
        <dt>${L.mode_share}</dt><dd>${f1(r.s0)}% → ${f1(r.s1)}%</dd></dl>
        <p>${fill(r.story ? L.line_story : L.line_context, vars)}</p>`;
    }

    root.querySelectorAll<HTMLButtonElement>(".nr-seg button").forEach((b) => b.addEventListener("click", () => {
      mode = b.dataset.mode as Mode;
      root.querySelectorAll<HTMLButtonElement>(".nr-seg button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      update(true);
    }));
    new ResizeObserver(() => draw()).observe(svgEl);
    draw(); show();
  });
</script>

<style is:global>
  [data-viz="nuclear-capacity-vs-share-regions"] { margin-block: 24px; }
  .nr-fig { padding: 12px; background: var(--panel); border-radius: var(--radius); }
  .nr-top { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; margin-bottom: 8px; }
  .nr-seg { display: inline-flex; border: 1px solid var(--rule); border-radius: 999px; padding: 2px; }
  .nr-seg button { font: 600 14px/1 var(--f-data); color: var(--ink-2); background: none; border: 0; border-radius: 999px; min-height: 44px; padding: 0 16px; cursor: pointer; }
  .nr-seg button[aria-pressed="true"] { background: var(--ink); color: var(--panel); }
  .nr-key { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font: 400 13px/1.3 var(--f-data); color: var(--ink-2); }
  .nr-key li { display: inline-flex; align-items: center; gap: 6px; }
  .nr-key .k-hollow { fill: var(--panel); stroke: var(--ink-3); stroke-width: 1.5; }
  .nr-key .k-fill { fill: var(--ink-3); }
  .nr-key .k-bar { width: 18px; height: 4px; border-radius: 2px; }
  .nr-key .k-bar.story { background: var(--cat-2); }
  .nr-key .k-bar.ctx { background: var(--cat-1); }
  .nr-svg { display: block; width: 100%; touch-action: pan-y; }
  .nr-svg:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .nr-svg text { font-family: var(--f-data); font-variant-numeric: tabular-nums; }
  .nr-svg .grid line { stroke: var(--grid); }
  .nr-svg .xax text { font-size: 12px; fill: var(--ink-3); text-anchor: middle; }
  .nr-svg .axt { font-size: 12px; fill: var(--ink-3); }
  .nr-svg .hit { fill: transparent; }
  .nr-svg .row.on .hit { fill: var(--bg); }
  .nr-svg .nm { font-size: 13px; fill: var(--ink-2); text-anchor: end; }
  .nr-svg .row.story .nm { fill: var(--ink); font-weight: 600; }
  .nr-svg .bar { stroke-width: 4; stroke-linecap: round; }
  .nr-svg .story .bar { stroke: var(--cat-2); }
  .nr-svg .ctx .bar { stroke: var(--cat-1); stroke-opacity: .55; }
  .nr-svg .c0 { fill: var(--panel); stroke-width: 2; }
  .nr-svg .story .c0 { stroke: var(--cat-2); }
  .nr-svg .ctx .c0 { stroke: var(--cat-1); }
  .nr-svg .story .c1 { fill: var(--cat-2); }
  .nr-svg .ctx .c1 { fill: var(--cat-1); }
  .nr-svg .vt { font-size: 13px; fill: var(--ink-2); }
  .nr-svg .story .vt { fill: var(--ink); font-weight: 600; }
  .nr-card { margin-top: 10px; padding: 10px 12px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg); font: 400 14px/1.35 var(--f-data); color: var(--ink); }
  .nr-card strong { font: 700 17px/1.2 var(--f-display); }
  .nr-card dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; margin: 6px 0 0; }
  .nr-card dt { color: var(--ink-2); }
  .nr-card dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .nr-card p { margin: 8px 0 0; color: var(--ink-2); }
  .nr:not(.js) .nr-fig { display: none; }
  .nr details { margin-top: 20px; font-size: 14px; }
  .nr summary { cursor: pointer; font-weight: 600; padding-block: 6px; }
  .nr .tbl { overflow-x: auto; margin-top: 10px; }
  .nr table { border-collapse: collapse; min-width: 480px; font-family: var(--f-data); }
  .nr caption { caption-side: bottom; text-align: left; font-size: 12px; color: var(--ink-3); padding-top: 8px; }
  .nr th, .nr td { text-align: left; padding: 5px 14px 5px 0; border-bottom: 1px solid var(--rule); }
  .nr .num { text-align: right; font-variant-numeric: tabular-nums; }
  @media (min-width: 900px) { .nr-fig { padding: 18px 20px; } }
</style>
