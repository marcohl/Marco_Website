---
// Bolivia's SIN power plants at the end of 2025: one circle per plant on a department map, area by
// capacity (MW) or by 2025 generation (GWh), plus a bar per department. Data:
// src/data/bolivia-power-plants/plants.json (built by analysis/bolivia-power-plants/build_data.py).
// Text: content/projects/bolivia-power-plants.md, sections [[map-chart]] and [[technologies]].
import data from "../../../data/bolivia-power-plants/plants.json";
import { content } from "../../../lib/content";
import { fill } from "../../../lib/fill";

const txt = content("projects/bolivia-power-plants");
const L = txt.labels("map-chart"), TECH = txt.labels("technologies");
const f0 = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 0 });
const f1 = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const rows = [...data.plants].sort((a, b) => b.capacity_mw - a.capacity_mw);
const t = data.meta.totals;
const deps = [...new Set(data.plants.map((p) => p.department))].sort((a, b) => a.localeCompare(b, "es"))
  .map((d) => ({ name: d, n: data.plants.filter((p) => p.department === d).length }));
---
<div class="bp" data-viz="bolivia-power-plants" data-text={JSON.stringify({ ...L, tech: TECH })}>
  <div class="bp-ctl">
    <span class="sp-seg bp-seg" role="group" aria-label={L.circle_size}>
      <button type="button" data-mode="mw" aria-pressed="true">{L.mode_mw}</button>
      <button type="button" data-mode="gwh" aria-pressed="false">{L.mode_gwh}</button>
    </span>
    <label class="bp-dep"><span>{L.department}</span>
      <select aria-label={L.department}>
        <option value="">{L.all_bolivia}</option>
        {deps.map((d) => <option value={d.name}>{d.name} ({d.n})</option>)}
      </select>
    </label>
  </div>

  <div class="bp-fig">
    <ul class="bp-legend" aria-label={L.legend_label}>
      {["gas", "hydro", "solar", "wind", "biomass"].map((g) => <li><button type="button" data-t={g} aria-pressed="false"><span class={`sw sw-${g}`}></span>{TECH[g]}</button></li>)}
      <li class="bp-approx"><span class="sw sw-ring"></span>{L.approximate}</li>
      <li class="bp-size" aria-hidden="true"><svg></svg><span></span></li>
    </ul>
    <div class="bp-grid">
      <div class="bp-mapbox">
        <button type="button" class="bp-back" hidden>{L.back}</button>
        <svg class="bp-map" tabindex="0" role="img"
          aria-label={fill(L.map_description, { plants: t.plants })}></svg>
      </div>
      <div class="bp-side">
        <div class="bp-card" aria-live="polite"><span class="bp-hint">{L.hint}</span></div>
        <div class="bp-list" hidden><p class="bp-list-h"></p><ul></ul></div>
        <figure class="bp-bars">
          <figcaption></figcaption>
          <svg role="img" aria-label={L.bars_description}></svg>
        </figure>
      </div>
    </div>
  </div>

  <slot name="insights" />

  <details>
    <summary>{fill(L.table_summary, { plants: t.plants })}</summary>
    <div class="tbl"><table>
      <caption>{L.table_caption}</caption>
      <thead><tr><th>{L.col_plant}</th><th>{L.col_technology}</th><th>{L.col_department}</th><th class="num">{L.col_mw}</th><th class="num">{L.col_gwh}</th><th class="num">{L.col_factor}</th></tr></thead>
      <tbody>{rows.map((p) => (
        <tr>
          <td>{p.name}{p.location_precision === "approximate" ? " *" : ""}</td>
          <td>{TECH[p.tech]}</td>
          <td>{p.department}</td>
          <td class="num">{f1(p.capacity_mw)}</td>
          <td class="num">{f1(p.generation_2025_gwh)}</td>
          <td class="num">{Math.round((p.capacity_factor_2025 ?? 0) * 100)}%</td>
        </tr>
      ))}</tbody>
      <tfoot><tr><th>{L.total_row}</th><td></td><td></td><td class="num">{f0(t.capacity_mw)}</td><td class="num">{f0(t.generation_2025_gwh)}</td><td class="num">{Math.round((t.generation_2025_gwh * 1000) / (t.capacity_mw * 8760) * 100)}%</td></tr></tfoot>
    </table></div>
  </details>
</div>

<script>
  import * as d3 from "d3";
  import data from "../../../data/bolivia-power-plants/plants.json";
  import depts from "../../../data/bolivia-power-plants/departments.json";
  import { fill } from "../../../lib/fill";

  type Mode = "mw" | "gwh";
  type Group = "gas" | "hydro" | "solar" | "wind" | "biomass";
  type Plant = (typeof data.plants)[number] & { g: Group; x: number; y: number };
  const GROUPS: Group[] = ["gas", "hydro", "solar", "wind", "biomass"];
  const groupOf = (t: string): Group => (["gas_cc", "gas_oc", "diesel", "dual_fuel"].includes(t) ? "gas" : (t as Group));
  const val = (p: Plant, m: Mode) => (m === "mw" ? p.capacity_mw : p.generation_2025_gwh);
  const fmt = (n: number, d = 1) => n.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d });
  const UNIT: Record<Mode, string> = { mw: "MW", gwh: "GWh" };
  // Zongo valley (COBEE): the cluster north of La Paz city, labelled on the map
  const ZONGO = ["Zongo", "Tiquimani", "Botijlaca", "Cuticucho", "Santa Rosa", "Sainani", "Chururaqui", "Harca", "Cahua", "Huaji"];

  document.querySelectorAll<HTMLElement>('[data-viz="bolivia-power-plants"]').forEach((root) => {
    root.classList.add("js");
    const L = JSON.parse(root.dataset.text!) as Record<string, string> & { tech: Record<string, string> };
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svgEl = q<SVGSVGElement>("svg.bp-map"), card = q<HTMLElement>(".bp-card");
    const barsEl = q<SVGSVGElement>(".bp-bars svg"), barsCap = q<HTMLElement>(".bp-bars figcaption");
    const sizeSvg = d3.select(q<SVGSVGElement>(".bp-size svg")), sizeTxt = q<HTMLElement>(".bp-size span");

    const plants: Plant[] = data.plants.map((p) => ({ ...p, g: groupOf(p.tech), x: 0, y: 0 }));
    let mode: Mode = "mw";
    let selected: Plant | null = null;
    const maxOf: Record<Mode, number> = { mw: d3.max(plants, (p) => p.capacity_mw)!, gwh: d3.max(plants, (p) => p.generation_2025_gwh)! };

    const svg = d3.select(svgEl);
    // The map and the marks sit in two "zoom" groups that share one transform; labels stay outside.
    const gDept = svg.append("g").attr("class", "zoom").append("g").attr("class", "dept");
    const gLab = svg.append("g").attr("class", "dlab");
    const gAnn = svg.append("g").attr("class", "ann");
    const gTop = svg.append("g").attr("class", "zoom");
    const gMarks = gTop.append("g").attr("class", "marks");
    const selRing = gTop.append("circle").attr("class", "sel").attr("r", 0);
    const zoomGs = svg.selectAll<SVGGElement, unknown>("g.zoom");
    const features = (depts as any).features as any[];
    const depSel = q<HTMLSelectElement>(".bp-dep select"), backBtn = q<HTMLButtonElement>(".bp-back");
    const listBox = q<HTMLElement>(".bp-list"), listH = q<HTMLElement>(".bp-list-h"), listUl = q<HTMLUListElement>(".bp-list ul");
    const hasPlants = new Set(plants.map((p) => p.department));
    // Department zoom: dep is the department shown (null = all of Bolivia), k the zoom factor.
    // Circles are divided by k so they keep their size on screen and the size key stays true.
    let dep: string | null = null, k = 1;
    const inDep = (p: Plant) => !dep || p.department === dep;
    const hint = () => `<span class="bp-hint">${dep ? fill(L.hint_department, { dep, n: plants.filter(inDep).length }) : L.hint}</span>`;

    let W = 0, H = 0, rMax = 24;
    const proj = d3.geoMercator();
    const path = d3.geoPath(proj);
    const r = (v: number, m: Mode = mode) => (v > 0 ? Math.max(1.4, Math.sqrt(v / maxOf[m]) * rMax) : 0);

    function drawBase() {
      gDept.selectAll<SVGPathElement, any>("path").data(features).join("path").attr("d", path as any)
        .classed("has", (d) => hasPlants.has(d.properties.name))
        .classed("off", (d) => !!dep && d.properties.name !== dep);
      gLab.selectAll("text").data((depts as any).features).join("text")
        .attr("transform", (d: any) => {
          const [x, y] = path.centroid(d);
          // Labels shifted off the dense clusters
          const k = W / 600;
          const off: Record<string, [number, number]> = {
            Cochabamba: [0, 46], "La Paz": [0, -60], "Santa Cruz": [40, -40], Tarija: [-6, 46], "Potosí": [-10, 34], Oruro: [-6, 18],
          };
          const [dx, dy] = off[d.properties.name] ?? [0, 0];
          return `translate(${x + dx * k},${y + dy * k})`;
        })
        .text((d: any) => d.properties.name);
      // Zongo valley annotation: leader from the cluster to a label west of it
      const z = plants.filter((p) => ZONGO.includes(p.name));
      const c = proj([d3.mean(z, (p) => p.lon)!, d3.mean(z, (p) => p.lat)!])!;
      const small = W < 560;
      const lx = Math.max(4, c[0] - (small ? 70 : 95)), ly = small ? c[1] - 28 : c[1] + 56;
      gAnn.selectAll("*").remove();
      gAnn.append("path").attr("d", small ? `M${c[0] - 4},${c[1] - 4}L${lx + 30},${ly + 4}` : `M${c[0] - 3},${c[1] + 5}L${lx + 20},${ly - 13}`);
      gAnn.append("text").attr("x", lx).attr("y", ly).text(L.zongo);
      // Two short lines so the total stays clear of the Cochabamba circles to the east
      if (!small) {
        gAnn.append("text").attr("class", "sub").attr("x", lx).attr("y", ly + 15).text(fill(L.zongo_plants, { n: z.length }));
        gAnn.append("text").attr("class", "sub").attr("x", lx).attr("y", ly + 29).text(`${fmt(d3.sum(z, (p) => val(p, mode)), 0)} ${UNIT[mode]}`);
      }
    }

    function place(animate = false) {
      for (const p of plants) { const xy = proj([p.lon, p.lat])!; p.x = xy[0]; p.y = xy[1]; }
      const order = [...plants].sort((a, b) => val(b, mode) - val(a, mode));
      const c = gMarks.selectAll<SVGCircleElement, Plant>("circle").data(order, (d) => d.id)
        .join("circle")
        .attr("class", (d) => `m t-${d.g}${d.location_precision === "approximate" ? " approx" : ""}${inDep(d) ? "" : " out"}`)
        .attr("data-t", (d) => d.g)
        .attr("cx", (d) => d.x).attr("cy", (d) => d.y);
      c.order();
      (animate && !reduce ? c.transition().duration(600).ease(d3.easeCubicOut) : c).attr("r", (d) => r(val(d, mode)) / k);
      if (selected) selRing.attr("cx", selected.x).attr("cy", selected.y).attr("r", (r(val(selected, mode)) + 3) / k);
      drawSize();
    }

    function drawSize() {
      const ref = mode === "mw" ? [100, 500] : [500, 2000];
      const rs = ref.map((v) => r(v)), h = Math.ceil(2 * rs[1] + 4);
      sizeSvg.attr("width", Math.ceil(2 * rs[0] + 2 * rs[1] + 12)).attr("height", h);
      sizeSvg.selectAll("circle").data(rs).join("circle")
        .attr("r", (d) => d).attr("cy", (d) => h - d - 2).attr("cx", (d, i) => (i ? 2 * rs[0] + 9 + d : d + 1));
      sizeTxt.textContent = fill(L.size_key, { a: ref[0].toLocaleString("en-US"), b: ref[1].toLocaleString("en-US"), unit: UNIT[mode] });
    }

    // Department bars, stacked by technology group, sorted by the current measure
    function drawBars(animate = false) {
      const by = d3.rollups(plants, (v) => Object.fromEntries(GROUPS.map((g) => [g, d3.sum(v.filter((p) => p.g === g), (p) => val(p, mode))])), (p) => p.department)
        .map(([dep, o]) => ({ dep, ...o, total: d3.sum(GROUPS, (g) => (o as any)[g]) }))
        .sort((a, b) => b.total - a.total);
      const total = d3.sum(by, (d) => d.total);
      const top3 = d3.sum(by.slice(0, 3), (d) => d.total);
      barsCap.textContent = fill(mode === "mw" ? L.bars_title_mw : L.bars_title_gwh,
        { top3: by.slice(0, 3).map((d) => d.dep).join(", "), pct: Math.round((top3 / total) * 100) });
      const bw = Math.round(barsEl.getBoundingClientRect().width) || 300;
      const rowH = 26, lab = 86, right = 64, bh = by.length * rowH + 4;
      const bsvg = d3.select(barsEl).attr("viewBox", `0 0 ${bw} ${bh}`).attr("height", bh);
      const x = d3.scaleLinear().domain([0, mode === "mw" ? 1400 : 4400]).range([lab, bw - right]);
      const stack = d3.stack<any>().keys(GROUPS)(by);
      const rowsSel = bsvg.selectAll<SVGGElement, any>("g.row").data(by, (d) => d.dep).join((e) => {
        const g = e.append("g").attr("class", "row");
        g.append("text").attr("class", "dl").attr("x", 0).attr("dy", "0.32em");
        g.append("text").attr("class", "dv").attr("dy", "0.32em");
        return g;
      });
      (animate && !reduce ? rowsSel.transition().duration(600).ease(d3.easeCubicOut) : rowsSel)
        .attr("transform", (d, i) => `translate(0,${i * rowH + rowH / 2 + 2})`);
      rowsSel.classed("off", (d) => !!dep && d.dep !== dep);
      rowsSel.select(".dl").text((d) => d.dep);
      rowsSel.select(".dv").text((d) => `${fmt(d.total, 0)} ${UNIT[mode]}`);
      (animate && !reduce ? rowsSel.select(".dv").transition().duration(600) : rowsSel.select(".dv")).attr("x", (d) => x(d.total) + 6);
      rowsSel.each(function (d) {
        const segs = GROUPS.map((g) => { const s = stack.find((k) => k.key === g)!.find((v) => v.data.dep === d.dep)!; return { g, x0: s[0], x1: s[1] }; });
        const rs = d3.select(this).selectAll<SVGRectElement, any>("rect").data(segs, (s: any) => s.g)
          .join("rect").attr("class", (s) => `t-${s.g}`).attr("data-t", (s) => s.g).attr("y", -8).attr("height", 16);
        (animate && !reduce ? rs.transition().duration(600).ease(d3.easeCubicOut) : rs)
          .attr("x", (s) => x(s.x0)).attr("width", (s) => Math.max(0, x(s.x1) - x(s.x0)));
      });
    }

    function resize() {
      const w = Math.round(svgEl.getBoundingClientRect().width) || 320;
      if (w === W) return;
      W = w; H = Math.round(W * 1.02);
      rMax = W < 560 ? 18 : 26;
      svg.attr("viewBox", `0 0 ${W} ${H}`).attr("height", H);
      proj.fitExtent([[6, 6], [W - 6, H - 6]], depts as any);
      drawBase(); zoomTo(dep, false); drawBars();
    }

    function zoomTo(name: string | null, animate = true) {
      dep = name && hasPlants.has(name) ? name : null;
      let x = 0, y = 0;
      k = 1;
      if (dep) {
        // Fit the department's plants, not its outline, so clusters spread as far as possible.
        // A minimum box keeps a one-plant department from zooming in without limit.
        for (const p of plants) { const xy = proj([p.lon, p.lat])!; p.x = xy[0]; p.y = xy[1]; }
        const ps = plants.filter(inDep), pad = rMax;
        const cx = (d3.min(ps, (p) => p.x)! + d3.max(ps, (p) => p.x)!) / 2, cy = (d3.min(ps, (p) => p.y)! + d3.max(ps, (p) => p.y)!) / 2;
        const bw = Math.max(W * 0.25, d3.max(ps, (p) => p.x)! - d3.min(ps, (p) => p.x)! + 2 * pad);
        const bh = Math.max(H * 0.25, d3.max(ps, (p) => p.y)! - d3.min(ps, (p) => p.y)! + 2 * pad);
        k = Math.min(8, W / bw, H / bh);
        x = W / 2 - k * cx; y = H / 2 - k * cy;
      }
      const go = animate && !reduce;
      (go ? zoomGs.transition().duration(650).ease(d3.easeCubicInOut) : zoomGs).attr("transform", `translate(${x},${y}) scale(${k})`);
      gDept.selectAll<SVGPathElement, any>("path").classed("off", (d) => !!dep && d.properties.name !== dep);
      gLab.attr("display", dep ? "none" : null); gAnn.attr("display", dep ? "none" : null);
      backBtn.hidden = !dep; depSel.value = dep ?? ""; root.dataset.dep = dep ?? "";
      if (selected && !inDep(selected)) selected = null;
      place(go);
      drawBars();
      drawList();
      if (selected) show(selected); else card.innerHTML = hint();
    }

    // With a department chosen, its plants as a list: the way to reach plants that overlap on the map.
    function drawList() {
      listBox.hidden = !dep;
      if (!dep) { listUl.innerHTML = ""; return; }
      const ps = plants.filter(inDep).sort((a, b) => val(b, mode) - val(a, mode));
      listH.textContent = fill(mode === "mw" ? L.list_title_mw : L.list_title_gwh, { dep });
      listUl.innerHTML = ps.map((p) => {
        const v = val(p, mode);
        return `<li><button type="button" data-id="${p.id}" aria-pressed="${p === selected}"><span class="sw sw-${p.g}"></span><span class="tx"><span class="nm">${p.name}${p.location_precision === "approximate" ? " *" : ""}</span><span class="v">${fmt(v, v < 10 ? 1 : 0)} ${UNIT[mode]}</span></span></button></li>`;
      }).join("");
    }
    listUl.addEventListener("click", (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>("button[data-id]");
      if (b) show(plants.find((p) => String(p.id) === b.dataset.id) ?? null);
    });

    function show(p: Plant | null) {
      selected = p;
      selRing.attr("r", p ? (r(val(p, mode)) + 3) / k : 0).attr("cx", p?.x ?? 0).attr("cy", p?.y ?? 0);
      listUl.querySelectorAll<HTMLButtonElement>("button[data-id]").forEach((b) => b.setAttribute("aria-pressed", String(!!p && b.dataset.id === String(p.id))));
      if (!p) { card.innerHTML = hint(); return; }
      const techs = Object.entries(p.capacity_by_tech_mw).map(([k, v]) => `${L.tech[k]} ${fmt(v as number)} MW`).join(", ");
      const cf = p.capacity_factor_2025 ?? 0;
      const line = fill(cf < 0.05 ? L.line_barely : cf > 0.6 ? L.line_high : L.line_mid, { pct: Math.round(cf * 100) });
      const approx = p.location_precision === "approximate" ? `<p class="bp-note">${fill(L.approx_note, { note: p.location_note })}</p>` : "";
      const units = fill(p.units === 1 ? L.unit_one : L.unit_many, { n: p.units });
      card.innerHTML = `<div class="bp-card-h"><strong>${p.name}</strong><span>${p.department}</span></div>
        <dl>
          <div><dt>${L.card_capacity}</dt><dd>${fmt(p.capacity_mw)} MW</dd></div>
          <div><dt>${L.card_generation}</dt><dd>${fmt(p.generation_2025_gwh)} GWh</dd></div>
          <div><dt>${L.card_factor}</dt><dd>${Math.round(cf * 100)}%</dd></div>
        </dl>
        <p class="bp-line">${line}</p>
        <p class="bp-meta">${fill(L.plant_details, { techs, units, operator: p.operator })}</p>${approx}`;
    }

    function nearest(px: number, py: number, reach = 22) {
      reach /= k;
      let best: Plant | null = null, bd = reach * reach;
      for (const p of plants) {
        if (!inDep(p)) continue;
        const d = (p.x - px) ** 2 + (p.y - py) ** 2 - (r(val(p, mode)) / k) ** 2 * 0.5;
        if (d < bd) { bd = d; best = p; }
      }
      return best;
    }
    svg.on("pointermove pointerdown", (ev: PointerEvent) => {
      const [x, y] = d3.pointer(ev, gTop.node());
      const p = nearest(x, y);
      if (p || ev.type === "pointerdown") show(p);
    });
    // A click (not a scroll gesture) on a department with no plant under the pointer zooms to it.
    svg.on("click", (ev: MouseEvent) => {
      const [x, y] = d3.pointer(ev, gTop.node());
      if (nearest(x, y)) return;
      const f = features.find((f) => d3.geoContains(f, proj.invert!([x, y])!));
      const name = f?.properties.name ?? null;
      if (name !== dep && (name === null || hasPlants.has(name))) zoomTo(name);
    });
    depSel.addEventListener("change", () => zoomTo(depSel.value || null));
    backBtn.addEventListener("click", () => { zoomTo(null); svgEl.focus(); });
    svgEl.addEventListener("keydown", (ev) => {
      if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp", "Escape"].includes(ev.key)) return;
      ev.preventDefault();
      if (ev.key === "Escape") return selected || !dep ? show(null) : zoomTo(null);
      const list = plants.filter(inDep).sort((a, b) => val(b, mode) - val(a, mode));
      const i = selected ? list.indexOf(selected) : -1;
      const step = ev.key === "ArrowRight" || ev.key === "ArrowDown" ? 1 : -1;
      show(list[(i + step + list.length) % list.length]);
    });

    root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) => b.addEventListener("click", () => {
      mode = b.dataset.mode as Mode;
      root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      root.dataset.mode = mode;
      drawBase(); place(true); drawBars(true); drawList();
      if (selected) show(selected);
    }));
    root.querySelectorAll<HTMLButtonElement>(".bp-legend [data-t]").forEach((b) => b.addEventListener("click", () => {
      const on = root.dataset.focus !== b.dataset.t;
      if (on) root.dataset.focus = b.dataset.t!; else delete root.dataset.focus;
      root.querySelectorAll<HTMLButtonElement>(".bp-legend [data-t]").forEach((x) => x.setAttribute("aria-pressed", String(on && x === b)));
    }));

    root.dataset.mode = mode;
    new ResizeObserver(() => resize()).observe(svgEl);
    resize();
  });
</script>

<style is:global>
  [data-viz="bolivia-power-plants"] { margin-block: 24px; }
  .bp .t-gas { fill: var(--tech-gas); background: var(--tech-gas); }
  .bp .t-hydro { fill: var(--tech-hydro); background: var(--tech-hydro); }
  .bp .t-solar { fill: var(--tech-solar); background: var(--tech-solar); }
  .bp .t-wind { fill: var(--tech-wind); background: var(--tech-wind); }
  .bp .t-biomass { fill: var(--tech-biomass); background: var(--tech-biomass); }

