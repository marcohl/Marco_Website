---
// Gross generation of Bolivia's national grid (SIN) by source, 1996-2025, as stacked columns.
// Data: src/data/bolivia-power-plants/history.json (CNDC Memoria y Resultados 2025).
import hist from "../../../data/bolivia-power-plants/history.json";
const s = hist.series;
const first = s[0], last = s[s.length - 1];
const f1 = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---
<div class="bh" data-viz="bolivia-power-plants-history">
  <div class="bh-fig">
    <ul class="bh-legend" aria-label="Source. Select one to highlight it.">
      <li><button type="button" data-t="gas" aria-pressed="false"><span class="sw t-gas"></span>Natural gas</button></li>
      <li><button type="button" data-t="hydro" aria-pressed="false"><span class="sw t-hydro"></span>Hydro</button></li>
      <li><button type="button" data-t="solar" aria-pressed="false"><span class="sw t-solar"></span>Solar</button></li>
      <li><button type="button" data-t="wind" aria-pressed="false"><span class="sw t-wind"></span>Wind</button></li>
      <li><button type="button" data-t="biomass" aria-pressed="false"><span class="sw t-biomass"></span>Biomass</button></li>
    </ul>
    <svg class="bh-svg" tabindex="0" role="img"
      aria-label={`Stacked columns of yearly gross generation by source, ${first.year} to ${last.year}. Total grew from ${f1(first.total)} to ${f1(last.total)} GWh. Use the arrow keys to read each year.`}></svg>
    <div class="bh-card" aria-live="polite"></div>
  </div>
  <details>
    <summary>Show the data: generation by source, {first.year}-{last.year}</summary>
    <div class="tbl"><table>
      <caption>GWh. CNDC, Memoria y Resultados 2025, "Producción bruta (GWh) periodo 1996-2025". Natural gas includes small diesel and dual-fuel output.</caption>
      <thead><tr><th>Year</th><th class="num">Natural gas</th><th class="num">Hydro</th><th class="num">Solar</th><th class="num">Wind</th><th class="num">Biomass</th><th class="num">Total</th></tr></thead>
      <tbody>{s.map((r) => (
        <tr><td>{r.year}</td><td class="num">{f1(r.thermal)}</td><td class="num">{f1(r.hydro)}</td><td class="num">{f1(r.solar)}</td><td class="num">{f1(r.wind)}</td><td class="num">{f1(r.biomass)}</td><td class="num">{f1(r.total)}</td></tr>
      ))}</tbody>
    </table></div>
  </details>
</div>

<script>
  import * as d3 from "d3";
  import hist from "../../../data/bolivia-power-plants/history.json";

  type Row = (typeof hist.series)[number];
  const KEYS = ["thermal", "hydro", "solar", "wind", "biomass"] as const;
  const GROUP: Record<string, string> = { thermal: "gas", hydro: "hydro", solar: "solar", wind: "wind", biomass: "biomass" };
  const LABEL: Record<string, string> = { thermal: "Natural gas", hydro: "Hydro", solar: "Solar", wind: "Wind", biomass: "Biomass" };
  const fmt = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

  document.querySelectorAll<HTMLElement>('[data-viz="bolivia-power-plants-history"]').forEach((root) => {
    root.classList.add("js");
    const svgEl = root.querySelector<SVGSVGElement>("svg.bh-svg")!, card = root.querySelector<HTMLElement>(".bh-card")!;
    const rows = hist.series as Row[];
    let sel = rows[rows.length - 1];
    const svg = d3.select(svgEl);
    let W = 0;

    function draw() {
      const w = Math.round(svgEl.getBoundingClientRect().width) || 320;
      if (w === W) return;
      W = w;
      const H = W < 560 ? 260 : 320, m = { t: 14, r: 8, b: 26, l: 46 };
      svg.attr("viewBox", `0 0 ${W} ${H}`).attr("height", H).selectAll("*").remove();
      const x = d3.scaleBand<number>().domain(rows.map((r) => r.year)).range([m.l, W - m.r]).paddingInner(W < 560 ? 0.15 : 0.22);
      const y = d3.scaleLinear().domain([0, 12000]).range([H - m.b, m.t]);
      svg.append("g").attr("class", "grid").selectAll("line").data(y.ticks(6)).join("line")
        .attr("x1", m.l).attr("x2", W - m.r).attr("y1", (d) => y(d)).attr("y2", (d) => y(d));
      svg.append("g").attr("class", "yax").selectAll("text").data(y.ticks(6)).join("text")
        .attr("x", m.l - 6).attr("y", (d) => y(d)).attr("dy", "0.32em").text((d) => d.toLocaleString("en-US"));
      svg.append("text").attr("class", "yt").attr("x", m.l + 4).attr("y", m.t + 2).text("GWh a year");
      const every = W < 560 ? 5 : 2;
      svg.append("g").attr("class", "xax").selectAll("text").data(rows.filter((r) => (2025 - r.year) % every === 0))
        .join("text").attr("x", (r) => x(r.year)! + x.bandwidth() / 2).attr("y", H - 8).text((r) => r.year);
      const stack = d3.stack<Row>().keys(KEYS as any)(rows);
      svg.append("g").attr("class", "cols").selectAll("g").data(stack).join("g")
        .attr("class", (s) => `t-${GROUP[s.key]}`).attr("data-t", (s) => GROUP[s.key])
        .selectAll("rect").data((s) => s).join("rect")
        .attr("x", (d) => x(d.data.year)!).attr("width", x.bandwidth())
        .attr("y", (d) => y(d[1])).attr("height", (d) => Math.max(0, y(d[0]) - y(d[1])));
      svg.append("line").attr("class", "base").attr("x1", m.l).attr("x2", W - m.r).attr("y1", y(0)).attr("y2", y(0));
      const ring = svg.append("rect").attr("class", "selc");
      const mark = () => ring.attr("x", x(sel.year)! - 2).attr("width", x.bandwidth() + 4).attr("y", y(sel.total) - 2).attr("height", y(0) - y(sel.total) + 2);
      mark();
      svg.on("pointermove pointerdown", (ev: PointerEvent) => {
        const [px] = d3.pointer(ev, svgEl);
        const i = Math.max(0, Math.min(rows.length - 1, Math.floor((px - m.l) / x.step())));
        sel = rows[i]; mark(); show();
      });
      svgEl.onkeydown = (ev) => {
        if (ev.key !== "ArrowRight" && ev.key !== "ArrowLeft") return;
        ev.preventDefault();
        const i = rows.indexOf(sel) + (ev.key === "ArrowRight" ? 1 : -1);
        sel = rows[(i + rows.length) % rows.length]; mark(); show();
      };
    }

    function show() {
      const gas = sel.thermal / sel.total;
      card.innerHTML = `<div class="bh-card-h"><strong>${sel.year}</strong><span>${fmt(sel.total)} GWh</span></div>
        <ul>${KEYS.filter((k) => sel[k] > 0).map((k) =>
          `<li><span class="sw t-${GROUP[k]}"></span>${LABEL[k]}<b>${fmt(sel[k])} GWh</b><small>${Math.round((sel[k] / sel.total) * 100)} %</small></li>`).join("")}</ul>
        <p class="bh-line">Natural gas made ${Math.round(gas * 100)} % of the electricity this year.</p>`;
    }

    root.querySelectorAll<HTMLButtonElement>(".bh-legend [data-t]").forEach((b) => b.addEventListener("click", () => {
      const on = root.dataset.focus !== b.dataset.t;
      if (on) root.dataset.focus = b.dataset.t!; else delete root.dataset.focus;
      root.querySelectorAll<HTMLButtonElement>(".bh-legend [data-t]").forEach((x) => x.setAttribute("aria-pressed", String(on && x === b)));
    }));
    new ResizeObserver(() => draw()).observe(svgEl);
    draw(); show();
  });
</script>

<style is:global>
  [data-viz="bolivia-power-plants-history"] { margin-block: 24px; }
  .bh .t-gas { fill: var(--tech-gas); background: var(--tech-gas); }
  .bh .t-hydro { fill: var(--tech-hydro); background: var(--tech-hydro); }
  .bh .t-solar { fill: var(--tech-solar); background: var(--tech-solar); }
  .bh .t-wind { fill: var(--tech-wind); background: var(--tech-wind); }
  .bh .t-biomass { fill: var(--tech-biomass); background: var(--tech-biomass); }
  .bh-fig { padding: 10px; background: var(--panel); border: 1px solid var(--rule); }
  .bh-legend { list-style: none; margin: 0 0 8px; padding: 0 0 8px; border-bottom: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: 0 6px; font: 400 13px/1.3 var(--f-data); color: var(--ink-2); }
  .bh-legend button { display: inline-flex; align-items: center; gap: 7px; font: inherit; color: inherit; background: none; border: 1px solid transparent; padding: 0 8px; min-height: 44px; cursor: pointer; }
  .bh-legend button[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); font-weight: 600; }
  .bh-legend button:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .bh .sw { display: inline-block; width: 13px; height: 13px; flex: none; border: 1px solid color-mix(in srgb, var(--ink) 55%, transparent); }
  .bh-svg { display: block; width: 100%; touch-action: manipulation; }
  .bh-svg:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .bh-svg .grid line { stroke: var(--grid); }
  .bh-svg .yax text { font: 400 12px var(--f-data); fill: var(--ink-3); text-anchor: end; }
  .bh-svg .yt { font: 400 12px var(--f-data); fill: var(--ink-3); paint-order: stroke; stroke: var(--panel); stroke-width: 3px; }
  .bh-svg .xax text { font: 400 12px var(--f-data); fill: var(--ink-2); text-anchor: middle; }
  .bh-svg .base { stroke: var(--ink-3); }
  .bh-svg .cols rect { stroke: var(--panel); stroke-width: .5; }
  .bh-svg .cols g { transition: opacity .15s; }
  .bh-svg .selc { fill: none; stroke: var(--ink); stroke-width: 1.5; pointer-events: none; }
  .bh[data-focus] .cols [data-t] { opacity: .18; }
  .bh[data-focus="gas"] .cols [data-t="gas"], .bh[data-focus="hydro"] .cols [data-t="hydro"], .bh[data-focus="solar"] .cols [data-t="solar"],
  .bh[data-focus="wind"] .cols [data-t="wind"], .bh[data-focus="biomass"] .cols [data-t="biomass"] { opacity: 1; }
  .bh-card { margin-top: 10px; padding: 10px 12px; border: 1px solid var(--rule); background: var(--bg); font: 400 14px/1.35 var(--f-data); color: var(--ink); }
  .bh-card-h { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
  .bh-card-h strong { font: 700 18px/1.2 var(--f-display); }
  .bh-card-h span { color: var(--ink-2); font-weight: 600; font-variant-numeric: tabular-nums; }
  .bh-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .bh-card li { display: grid; grid-template-columns: 13px 1fr auto 3.2em; column-gap: 8px; align-items: center; }
  .bh-card li b { font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
  .bh-card li small { text-align: right; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .bh-line { margin: 8px 0 0; color: var(--ink-2); }
  .bh:not(.js) .bh-fig { display: none; }
  .bh details { margin-top: 20px; font-size: 14px; }
  .bh summary { cursor: pointer; font-weight: 600; padding-block: 6px; }
  .bh .tbl { overflow-x: auto; margin-top: 10px; }
  .bh table { border-collapse: collapse; min-width: 560px; font-family: var(--f-data); }
  .bh caption { caption-side: bottom; text-align: left; font-size: 12px; color: var(--ink-3); padding-top: 8px; }
  .bh th, .bh td { text-align: left; padding: 5px 14px 5px 0; border-bottom: 1px solid var(--rule); }
  .bh .num { text-align: right; font-variant-numeric: tabular-nums; }
  @media (min-width: 900px) {
    [data-viz="bolivia-power-plants-history"] { margin-block: 32px; }
    .bh-fig { padding: 18px 20px; }
    .bh-fig { display: grid; grid-template-columns: minmax(0, 1fr) 280px; column-gap: 24px; }
    .bh-legend { grid-column: 1 / -1; }
    .bh-card { margin-top: 0; align-self: start; }
  }
</style>
