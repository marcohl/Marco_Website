---
// Home-page thumbnail: three bars of uranium, one per stage, with the U-235 share by mass in the story color.
// Bars rather than atoms, so it does not repeat the home hero (data from the project).
import waffles from "../../../data/uranium-enrichment/waffles.json";
const { title } = Astro.props;
const W = 320, BAR = 34, GAP = 22;
const H = waffles.cases.length * BAR + (waffles.cases.length - 1) * GAP;
const bars = waffles.cases.map((c, i) => ({ y: i * (BAR + GAP), w: Math.max(2, (c.u235_mass_pct / 100) * W) }));
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}: U-235 is ${waffles.cases.map((c) => `${c.u235_mass_pct}%`).join(", ")} of the uranium as mined, as reactor fuel and as weapons-grade`}>
  {bars.map((b) => <>
    <rect class="ctx" x="0" y={b.y} width={W} height={BAR} rx="3" />
    <rect class="story" x="0" y={b.y} width={b.w} height={BAR} rx="3" />
  </>)}
</svg>

<style>
  .ctx { fill: var(--cat-1); }
  .story { fill: var(--cat-2); }
</style>
