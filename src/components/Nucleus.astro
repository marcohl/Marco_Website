---
// Stylized uranium nucleus: protons (red) and neutrons (blue). An icon, not to scale:
// real U-235 has 92 protons and 143 neutrons. Flat discs, so it matches the line-drawing style of the site.
interface Props { size?: number }
const { size = 56 } = Astro.props;
// [x, y, isProton]
const NUCLEONS: [number, number, boolean][] = [
  [7.2, 9.3, true], [16.6, 28.9, true], [30.9, 4.2, false], [9.1, -19.5, true], [-8.3, -16.0, true], [20.5, -31.8, true],
  [-1.4, 29.6, false], [-36.0, 9.5, true], [-30.9, -23.9, true], [-19.5, -23.4, false], [39.5, -3.3, false], [-13.6, 32.6, false],
  [0.8, -9.6, true], [-3.4, -26.1, false], [23.9, -5.3, false], [7.2, -31.8, false], [-14.6, 20.8, false], [6.5, 37.9, true],
  [-5.0, 4.6, false], [-28.0, 1.2, true], [12.8, -8.2, false], [0.2, -40.8, false], [0.0, 0.0, true], [18.1, 6.6, false],
  [6.7, 21.5, false], [-12.2, -33.9, true], [-18.9, 7.8, true], [-4.3, 16.1, true], [31.5, -14.5, false], [-20.4, -11.8, true],
  [-26.2, 18.2, false], [-27.3, 29.5, false], [20.5, -20.3, false], [20.8, 17.5, false], [-13.4, -2.4, true], [-32.4, -10.3, true],
  [32.4, 17.0, true],
];
---
<svg width={size} height={size} viewBox="-50 -50 100 100" role="img" aria-label="Stylized uranium nucleus: protons in red, neutrons in blue" style="flex:none;display:block">
  {NUCLEONS.map(([x, y, p]) => <circle cx={x} cy={y} r="7.6" fill={p ? "var(--cat-2)" : "var(--cat-1)"} stroke="var(--bg)" stroke-width="1.2" />)}
</svg>
