    <radialGradient id="nuc-p" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#F59A5A" /><stop offset="0.55" stop-color="#CF5F14" /><stop offset="1" stop-color="#8F3F0B" /></radialGradient>
    <radialGradient id="nuc-n" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#8DB3DB" /><stop offset="0.55" stop-color="#3F74AC" /><stop offset="1" stop-color="#234B75" /></radialGradient>
  </defs>
  <circle cx="7.2" cy="9.3" r="7.6" fill="url(#nuc-p)" />
  <circle cx="16.6" cy="28.9" r="7.6" fill="url(#nuc-p)" />
  <circle cx="30.9" cy="4.2" r="7.6" fill="url(#nuc-n)" />
  <circle cx="9.1" cy="-19.5" r="7.6" fill="url(#nuc-p)" />
