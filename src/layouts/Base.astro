---
import "@fontsource/barlow-semi-condensed/400.css";
import "@fontsource/barlow-semi-condensed/600.css";
import "@fontsource/barlow-semi-condensed/700.css";
import "@fontsource-variable/atkinson-hyperlegible-next/wght.css";
import "@fontsource-variable/literata/wght.css";
import "../styles/tokens.css";
import Nucleus from "../components/Nucleus.astro";
interface Props { title: string; description?: string; image?: string; type?: "website" | "article"; noindex?: boolean; }
const {
  title,
  description = "Data analysis and science, one chart at a time.",
  image = "/og/default.png",
  type = "website",
  noindex = false,
} = Astro.props;
// Canonical and og:image must be absolute URLs; they are emitted only once `site` is set in astro.config.mjs.
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : undefined;
const linkedin = "https://www.linkedin.com/in/marco-herbas-l%C3%B3pez-315530bb";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Marco Herbas Lopez" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script is:inline>
      try { if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (e) {}
    </script>
  </head>
  <body>
    <header class="wrap site">
      <div class="bar">
        <a class="brand" href="/">
          <Nucleus size={44} />
          <span class="who"><span class="name">Marco Herbas Lopez</span><span class="disc">Energy, data and everything else</span></span>
        </a>
        <nav class="links" aria-label="Main">
          <a href="/#work">Projects</a>
          <a href="/#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
        <button id="theme-toggle" type="button" aria-pressed="false">Dark</button>
      </div>
    </header>

    <main><slot /></main>

    <footer id="contact" class="foot-outer"><div class="wrap foot">
      <div class="contact">
        <span class="lbl">Contact</span>
        <ul>
          <li><a href="mailto:marcoherbas8@gmail.com">marcoherbas8@gmail.com</a></li>
          <li><a href={linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <div class="legal"><span>© 2026 Marco Herbas Lopez</span><span>Built with Astro and d3.js</span></div>
    </div></footer>

    <script is:inline>
      (function () {
        var b = document.getElementById("theme-toggle"), root = document.documentElement;
        function sync() { var d = root.dataset.theme === "dark"; b.textContent = d ? "Light" : "Dark"; b.setAttribute("aria-pressed", String(d)); }
        b.addEventListener("click", function () {
          var d = root.dataset.theme === "dark";
          if (d) delete root.dataset.theme; else root.dataset.theme = "dark";
          try { localStorage.setItem("theme", d ? "light" : "dark"); } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
<style>
  /* Mobile first: brand and toggle on row 1, links on row 2. One row from 700px. */
  .site { padding-block: 10px 0; }
  .lbl { font: 600 18px/1.2 var(--f-display); color: var(--ink); }
  .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 12px; border-bottom: 2px solid var(--ink); padding-block: 8px 0; }
  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; color: var(--ink); }
  .who { display: grid; gap: 4px; min-width: 0; }
  .name { font: 700 22px/1 var(--f-display); letter-spacing: -.005em; }
  .disc { font: 400 15px/1.1 var(--f-display); color: var(--ink-3); }
  .links { grid-column: 1 / -1; grid-row: 2; display: flex; gap: 22px; font: 600 18px/1 var(--f-display); }
  .links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  #theme-toggle { font: 600 16px/1 var(--f-display); color: var(--ink); background: none; border: 1px solid var(--ink); border-radius: 0; padding: 0 14px; min-height: 40px; cursor: pointer; }
  #theme-toggle:hover { background: var(--marker); color: var(--on-marker); border-color: var(--on-marker); }

  .foot-outer { margin-top: 64px; border-top: 2px solid var(--ink); }
  .foot { padding-block: 28px 40px; display: grid; gap: 24px; }
  .contact { display: grid; gap: 10px; }
  .contact ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font: 600 18px/1.3 var(--f-display); }
  .contact a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .legal { display: grid; gap: 4px; font: 400 15px/1.3 var(--f-display); color: var(--ink-3); }

  @media (min-width: 700px) {
    .site { padding-block: 14px 0; }
    .bar { grid-template-columns: minmax(0, 1fr) auto auto; gap: 0 28px; padding-block: 10px; }
    .links { grid-column: auto; grid-row: auto; gap: 28px; font-size: 19px; }
    .foot { grid-template-columns: 1fr auto; align-items: end; }
    .contact ul { display: flex; gap: 28px; }
    .legal { text-align: right; }
  }
</style>
