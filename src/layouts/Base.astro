---
import "../styles/tokens.css";
import Nucleus from "../components/Nucleus.astro";
interface Props { title: string; description?: string; }
const {
  title,
  description = "Data analysis and science, one chart at a time.",
} = Astro.props;
const linkedin = "https://www.linkedin.com/in/marco-herbas-l%C3%B3pez-315530bb";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      try { if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,500..800&family=JetBrains+Mono:wght@400;600&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body>
    <header class="wrap site">
      <div class="bar">
        <a class="brand" href="/">
          <Nucleus size={44} />
          <span class="who"><span class="name">Marco Herbas Lopez</span><span class="disc">Energy · Data · Everything</span></span>
        </a>
        <nav class="links" aria-label="Main">
          <a href="/#work">Projects</a>
          <a href="/#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
        <button id="theme-toggle" type="button" aria-pressed="false">Dark</button>
      </div>
    </header>

    <main><slot /></main>

    <footer id="contact" class="foot-outer"><div class="wrap foot">
      <div class="contact">
        <span class="lbl">Contact</span>
        <ul>
          <li><a href="mailto:marcoherbas8@gmail.com">marcoherbas8@gmail.com</a></li>
          <li><a href={linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <div class="legal"><span>© 2026 Marco Herbas Lopez</span><span>Built with Astro and d3.js</span></div>
    </div></footer>

    <script is:inline>
      (function () {
        var b = document.getElementById("theme-toggle"), root = document.documentElement;
        function sync() { var d = root.dataset.theme === "dark"; b.textContent = d ? "Light" : "Dark"; b.setAttribute("aria-pressed", String(d)); }
        b.addEventListener("click", function () {
          var d = root.dataset.theme === "dark";
          if (d) delete root.dataset.theme; else root.dataset.theme = "dark";
          try { localStorage.setItem("theme", d ? "light" : "dark"); } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
<style>
  /* Mobile first: stacked cartouche; the five-column title block starts at 900px. */
  .site { padding-block: 10px 0; }
  .lbl { font: 600 10px/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  /* Mobile first: brand and toggle on row 1, links on row 2. One row from 700px. */
  .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 12px; border-bottom: 2px solid var(--ink); padding-block: 8px 0; }
  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; color: var(--ink); }
  .who { display: grid; gap: 6px; min-width: 0; }
  .name { font: 700 18px/1 var(--f-display); font-stretch: 85%; letter-spacing: -.01em; }
  .disc { font: 600 10px/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .links { grid-column: 1 / -1; grid-row: 2; display: flex; gap: 22px; font-size: 15px; font-weight: 600; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 5px; }
  #theme-toggle { font: 600 12px/1 var(--f-mono); color: var(--ink-2); background: none; border: 1px solid var(--rule); border-radius: 99px; padding: 0 14px; min-height: 40px; cursor: pointer; }
  #theme-toggle:hover { border-color: var(--ink-3); }

  .foot-outer { margin-top: 64px; border-top: 1px solid var(--rule); }
  .foot { padding-block: 28px 40px; display: grid; gap: 24px; }
  .contact { display: grid; gap: 10px; }
  .contact ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-size: 16px; }
  .contact a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .legal { display: grid; gap: 4px; font-size: 14px; color: var(--ink-3); }

  @media (min-width: 700px) {
    .site { padding-block: 14px 0; }
    .bar { grid-template-columns: minmax(0, 1fr) auto auto; gap: 0 28px; padding-block: 10px; }
    .links { grid-column: auto; grid-row: auto; gap: 28px; font-size: 16px; }
    .name { font-size: 20px; }
    .foot { grid-template-columns: 1fr auto; align-items: end; }
    .contact ul { display: flex; gap: 28px; }
    .legal { text-align: right; }
  }
</style>
