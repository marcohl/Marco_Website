---
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
// Social image: public/og/<slug>.png (1200x630), slug taken from the page URL.
const slug = Astro.url.pathname.split("/").filter(Boolean).pop();
const ym = (d: unknown) => new Date(d as string).toISOString().slice(0, 7);
const subject = frontmatter.eyebrow ?? frontmatter.tags?.join(", ");
---
<Base title={frontmatter.title} description={frontmatter.description} image={`/og/${slug}.png`} type="article">
  <div class="wrap post">
    <article>
      <div class="tblock cartouche">
        <div><small>Drawing no.</small><b>{frontmatter.code}</b></div>
        <div><small>Subject</small><b>{subject}</b></div>
        <div><small>Revision</small><b>{frontmatter.rev ?? "A"}</b></div>
        <div><small>Date</small><b>{ym(frontmatter.date)}</b></div>
      </div>
      <slot />
    </article>
  </div>
</Base>

<style>
  .post { padding-top: 28px; }
  .cartouche { margin-bottom: 28px; }
  @media (min-width: 560px) { .cartouche { grid-template-columns: .9fr 2.2fr .7fr .8fr; } }
  @media (min-width: 700px) { .post { padding-top: 36px; } }
</style>
