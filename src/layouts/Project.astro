---
import Base from "./Base.astro";
import { content, projectInfo } from "../lib/content";
const P = content("site").labels("project-page");
// Social image: public/og/<slug>.png (1200x630), slug taken from the page URL.
const slug = Astro.url.pathname.split("/").filter(Boolean).pop()!;
// Title, description and eyebrow come from content/projects/<slug>.md; the rest from the MDX frontmatter.
const frontmatter = { ...Astro.props.frontmatter, ...projectInfo(slug) };
const month = (d: unknown) => new Date(d as string).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const subject = frontmatter.eyebrow ?? frontmatter.tags?.join(", ");
// "Next project": the next older published project, wrapping to the newest.
const modules = import.meta.glob("../pages/projects/*.mdx", { eager: true }) as Record<string, any>;
const projects = Object.entries(modules)
  .map(([path, mod]) => { const s = path.split("/").pop()!.replace(".mdx", ""); return { ...mod.frontmatter, ...projectInfo(s), slug: s }; })
  .filter((p) => p.status === "published" || import.meta.env.DEV)
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const i = projects.findIndex((p) => p.slug === slug);
const next = projects.length > 1 ? projects[(i + 1) % projects.length] : undefined;
---
<Base world="iso" title={frontmatter.title} description={frontmatter.description} image={`/og/${slug}.png`} type="article">
  <div class="wrap post">
    <article>
      <p class="meta"><a href="/#work">{P.breadcrumb}</a><span aria-hidden="true">/</span>{subject}<span aria-hidden="true">·</span>{month(frontmatter.date)}</p>
      <slot />
    </article>
    {next && (
      <nav class="next" aria-label="Next project">
        <a href={`/projects/${next.slug}/`}><span>{P.next_project}</span><b>{next.title}</b></a>
      </nav>
    )}
  </div>
</Base>

<style>
  .post { padding-top: 24px; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 10px; margin: 0 0 20px; font: 600 16px/1.3 var(--f-display); color: var(--ink-2); }
  .meta a { color: var(--ink); text-decoration-color: var(--cat-1); text-decoration-thickness: 2px; }
  .next { margin-top: 56px; }
  .next a { display: grid; gap: 6px; padding: 22px 24px; border-radius: var(--radius); background: var(--field-blue); color: var(--on-field); text-decoration: none; max-width: 560px; }
  .next span { font-size: 15px; font-weight: 600; opacity: .9; }
  .next b { font: 800 26px/1.15 var(--f-display); text-wrap: balance; }
  .next a:hover b, .next a:focus-visible b { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .next a:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  @media (min-width: 700px) { .post { padding-top: 32px; } }
</style>
